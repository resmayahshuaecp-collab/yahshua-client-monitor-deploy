# manage.py calls os.environ.setdefault("DJANGO_SETTINGS_MODULE", ...) before
# this file is ever read, so a value here is inert for the native path --
# it only takes effect if exported as a real shell variable ahead of
# manage.py, or inside a container where compose sets it directly (see
# docker-compose.yml). Kept here for documentation and for tools that read
# .env directly rather than going through manage.py.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-not-a-real-secret
# config/settings/production.py reads this with NO default and refuses to
# start without it -- this value is for local/dev settings only. A
# production deploy must set its own DJANGO_SECRET_KEY and must never use
# this one (it is public, being committed here).
DATABASE_URL=postgres://client_monitor:client_monitor@localhost:5439/client_monitor
AUTH_PROVIDER=local
FRONTEND_ORIGIN=http://localhost:3003
# Extra Host headers config/settings/local.py will accept, beyond its
# built-in default of localhost/127.0.0.1/backend/0.0.0.0. Comma-separated;
# usually unneeded -- see local.py for why "backend" is already covered.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
