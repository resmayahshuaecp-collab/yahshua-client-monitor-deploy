# The build context is sent to the daemon in full -- keep it small and keep
# host-only artifacts out of the image.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.sqlite3
staticfiles/

# Every .env variant, not just .env -- a secret baked into an image layer
# is still in the image after a later step deletes it.
.env
.env.*
!.env.example
