# node_modules is ~360 packages built for the host platform. Shipping it into
# the context is slow and can break the image with host-native binaries --
# the image installs its own.
node_modules/
.next/
test-results/
playwright-report/
*.tsbuildinfo

# Every .env variant, not just .env -- a secret baked into an image layer
# is still in the image after a later step deletes it.
.env
.env.*
!.env.local.example
